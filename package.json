{
  "author": "eniallator",
  "description": "Colony builder",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=25.4.0"
  },
  "license": "MIT",
  "name": "colony-builder",
  "packageManager": "pnpm@12.15.0",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "claudeLibDocs": [
    "deep-guards",
    "method-monitor",
    "niall-utils",
    "seriform",
    "vectyped",
    "simplex-noise"
  ],
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  },
  "scripts": {
    "build": "pnpm --filter @colony-builder/client build",
    "watch": "pnpm -r --parallel run watch",
    "client": "pnpm --filter @colony-builder/client run",
    "server-core": "pnpm --filter @colony-builder/server-core run",
    "server-node": "pnpm --filter @colony-builder/server-node run",
    "shared": "pnpm --filter @colony-builder/shared run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "lib-docs": "node scripts/lib-docs.mjs",
    "atlas": "node scripts/generate-atlas.mjs",
    "atlas:check": "node scripts/generate-atlas.mjs --strict",
    "postinstall": "pnpm lib-docs && pnpm atlas",
    "prepublish": "pnpm build && pnpm findissues",
    "test": "vitest run --config vitest.config.ts"
  }
}
